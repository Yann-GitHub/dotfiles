#!/usr/bin/env bash

# Homelab service health checks

set -u

TIMEOUT=8
CONNECT_TIMEOUT=3

check_http_service() {
  local name="$1"
  local url="$2"
  local result
  local http_code
  local duration

  result=$(curl -sS \
    --connect-timeout "$CONNECT_TIMEOUT" \
    --max-time "$TIMEOUT" \
    -o /dev/null \
    -w '%{http_code} %{time_total}' \
    "$url" 2>/dev/null) || result="000 0"

  http_code="${result%% *}"
  duration="${result#* }"

  if [[ "$http_code" =~ ^[0-9]{3}$ ]] &&
    ((10#$http_code >= 200 && 10#$http_code < 400)); then
    printf '[OK]   %-12s HTTP %s (%ss)\n' \
      "$name" "$http_code" "$duration"
  else
    printf '[FAIL] %-12s HTTP %s\n' "$name" "$http_code"
    return 1
  fi
}

check_postgresql() {
  if ! docker inspect \
    --format '{{.State.Running}}' postgres 2>/dev/null |
    grep -qx true; then
    printf '[FAIL] %-12s Container is not running\n' "PostgreSQL"
    return 1
  fi

  if docker exec postgres \
    pg_isready -U miniflux -d miniflux >/dev/null 2>&1; then
    printf '[OK]   %-12s Accepting connections\n' "PostgreSQL"
  else
    printf '[FAIL] %-12s Not accepting connections\n' "PostgreSQL"
    return 1
  fi
}

main() {
  local failures=0

  printf '\n=== Homelab Health Check ===\n'
  printf 'Date: %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S')"

  check_http_service "Grafana" \
    "http://localhost:3001/api/health" || ((failures += 1))

  check_http_service "Homepage" \
    "http://localhost:3000/" || ((failures += 1))

  check_http_service "Linkding" \
    "http://localhost:9090/" || ((failures += 1))

  check_http_service "Miniflux" \
    "http://localhost:8080/healthcheck" || ((failures += 1))

  check_postgresql || ((failures += 1))

  printf '\n'

  if ((failures == 0)); then
    printf 'Result: All services are responding.\n'
  else
    printf 'Result: %s service(s) failed.\n' "$failures"
  fi

  return "$((failures > 0))"
}

main "$@"

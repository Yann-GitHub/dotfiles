#!/usr/bin/env bash

# Download media and extract its audio as MP3.

# Requires yt-dlp to be installed and available in PATH.

# Requires FFmpeg (and ffprobe) for audio extraction and conversion.

# Output files are saved in the current directory, using the media title as the filename.

# --ignore-errors: Continue processing other items when an error occurs.

# --output: Set the output filename template.

# --extract-audio: Extract the audio track from the downloaded media.

# --audio-format mp3: Convert the extracted audio to MP3.

# "$@": Pass all command-line arguments to yt-dlp, preserving arguments containing spaces.

exec yt-dlp \
 --ignore-errors \
 --output "%(title)s.%(ext)s" \
 --extract-audio \
 --audio-format mp3 \
 "$@"

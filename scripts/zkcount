#!/usr/bin/env bash

set -euo pipefail

ZETTELKASTEN="$HOME/Zettelkasten"

if [[ ! -d "$ZETTELKASTEN" ]]; then
    echo "Error: Zettelkasten directory not found: $ZETTELKASTEN" >&2
    exit 1
fi

if command -v fd >/dev/null 2>&1; then
    FD="$(command -v fd)"
elif command -v fdfind >/dev/null 2>&1; then
    FD="$(command -v fdfind)"
else
    echo "Error: fd/fdfind is not installed." >&2
    exit 1
fi

COUNT=$("$FD" -L -e md . "$ZETTELKASTEN" | wc -l | tr -d '[:space:]')

printf 'Zettelkasten: %s notes\n' "$COUNT"